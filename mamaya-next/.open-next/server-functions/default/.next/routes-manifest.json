{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/admin/food/[batchId]",
      "regex": "^/admin/food/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPbatchId": "nxtPbatchId"
      },
      "namedRegex": "^/admin/food/(?<nxtPbatchId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/admin/jastip/[tripId]",
      "regex": "^/admin/jastip/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtripId": "nxtPtripId"
      },
      "namedRegex": "^/admin/jastip/(?<nxtPtripId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/admin/orders/[id]",
      "regex": "^/admin/orders/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/admin/orders/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/admin/tickets/[eventId]",
      "regex": "^/admin/tickets/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPeventId": "nxtPeventId"
      },
      "namedRegex": "^/admin/tickets/(?<nxtPeventId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/jastip/[slug]",
      "regex": "^/jastip/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/jastip/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/tickets/[slug]",
      "regex": "^/tickets/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/tickets/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/food",
      "regex": "^/admin/food(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/food(?:/)?$"
    },
    {
      "page": "/admin/food/master",
      "regex": "^/admin/food/master(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/food/master(?:/)?$"
    },
    {
      "page": "/admin/jastip",
      "regex": "^/admin/jastip(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/jastip(?:/)?$"
    },
    {
      "page": "/admin/login",
      "regex": "^/admin/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/login(?:/)?$"
    },
    {
      "page": "/admin/orders",
      "regex": "^/admin/orders(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/orders(?:/)?$"
    },
    {
      "page": "/admin/tickets",
      "regex": "^/admin/tickets(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/tickets(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/food",
      "regex": "^/food(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/food(?:/)?$"
    },
    {
      "page": "/jastip",
      "regex": "^/jastip(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/jastip(?:/)?$"
    },
    {
      "page": "/tickets",
      "regex": "^/tickets(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tickets(?:/)?$"
    },
    {
      "page": "/track",
      "regex": "^/track(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/track(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
